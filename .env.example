# Where the server listens. A host such as Render sets PORT itself.
PORT=8000
SERVER_HOST=0.0.0.0

# Database connection string
MONGODB_URI=

# Origin allowed to call the server from a browser; * for any
CORS_ORIGIN=*

# Long random texts that logins are signed with, and how long they last
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# The public address of this server, without a slash at the end.
# The links in verification and reset emails are built from it.
DOMAIN_NAME=http://localhost:8000

# Pictures and videos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email, option 1: Brevo HTTPS API. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=

# Email, option 2: SMTP. Used when BREVO_API_KEY is empty.
MAIL_HOST=
EMAIL_PORT=
MAIL_USER=
MAIL_PASS=
